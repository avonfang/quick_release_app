<view class="tab-bar {{isDark ? 'tab-bar--dark' : 'tab-bar--light'}}">
  <view
    class="tab-item {{active === index ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="label"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tab-icon">{{item.icon}}</text>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
