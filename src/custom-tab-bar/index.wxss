.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: space-around;
  z-index: 100;
}

.tab-bar--dark {
  background: rgba(42, 35, 29, 0.92);
  border-top: 2rpx solid rgba(255,255,255,0.06);
}

.tab-bar--light {
  background: rgba(248, 245, 240, 0.92);
  border-top: 2rpx solid rgba(0,0,0,0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100%;
  position: relative;
  border-radius: 16rpx;
  margin: 4rpx;
  -webkit-tap-highlight-color: transparent;
}

.tab-bar--dark .tab-item:active {
  background: rgba(255,255,255,0.08);
}

.tab-bar--light .tab-item:active {
  background: rgba(0,0,0,0.04);
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-item.active {
  background: rgba(198,156,109,0.08);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 32rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #C69C6D;
  transform: translateX(-50%);
}

.tab-item.active .tab-icon {
  transform: translateY(-2rpx);
}

.tab-icon {
  font-size: 40rpx;
  display: block;
  line-height: 1;
}

.tab-label {
  font-size: 22rpx;
  display: block;
  font-weight: 500;
}

.tab-item.active .tab-label {
  color: #C69C6D;
  font-weight: 600;
}

/* ── Dark ── */
.tab-bar--dark .tab-label {
  color: rgba(255,255,255,0.35);
}

/* ── Light ── */
.tab-bar--light .tab-label {
  color: rgba(0,0,0,0.35);
}
