.h5-pattern-item { display: flex; gap: 14px; align-items: flex-start; padding: 12px 16px; margin-bottom: 8px; background: #F8F5F0; border-radius: 12px; }
.h5-pattern-dot { width: 8px; height: 8px; border-radius: 50%; background: #C49A6C; flex-shrink: 0; margin-top: 6px; }
.h5-pattern-body { display: flex; flex-direction: column; gap: 2px; }
.h5-pattern-label { font-size: 14px; font-weight: 600; color: #1C1A17; }
.h5-pattern-detail { font-size: 13px; color: #6A6258; line-height: 1.5; }
.h5-insight { display: flex; flex-direction: column; align-items: center; padding: 12px 32px 28px; gap: 14px; }
.h5-insight-line { width: 24px; height: 2px; background: #C49A6C; border-radius: 1px; }
.h5-insight-text { font-size: 14px; color: #6A6258; line-height: 1.8; text-align: center; font-style: italic; }
.h5-card-footer { padding: 16px 32px 24px; border-top: 1px solid #F0ECE6; text-align: center; }
.h5-card-footer-label { font-size: 11px; color: #C4B8AC; letter-spacing: 2px; }
.h5-actions { padding: 24px 4px 20px; }
.h5-btn-primary-outer { padding: 2px; border-radius: 28px; background: linear-gradient(135deg, #C49A6C, #B8885A); }
.h5-btn-primary-inner { display: flex; align-items: center; justify-content: center; height: 52px; background: linear-gradient(135deg, #C49A6C, #B8885A); border-radius: 26px; cursor: pointer; transition: transform .3s cubic-bezier(.32, .72, 0, 1); }
.h5-btn-primary-inner:active { transform: scale(.97); }
.h5-btn-primary-text { color: #fff; font-size: 15px; font-weight: 500; letter-spacing: 2px; }
@media (max-width: 480px) {
  .h5-user-card { margin: 12px 16px; padding: 18px; }
  .h5-menu { margin: 4px 16px 32px; }
  .h5-menu-item { padding: 16px; }
  .h5-content { padding: 16px 16px 40px; }
  .h5-card-header { padding: 28px 24px 20px; }
  .h5-finding { padding: 16px 24px 0; }
  .h5-finding-text { font-size: 18px; }
  .h5-patterns { padding: 0 24px 16px; }
  .h5-insight { padding: 8px 24px 24px; }
}
</style>
<!--#endif-->

<!--#ifdef MP-WEIXIN-->
