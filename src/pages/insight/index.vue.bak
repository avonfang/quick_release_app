.h5-nav-back-text { font-size: 14px; color: #8a7e72; }
.h5-nav-title { font-size: 15px; font-weight: 600; color: #1c1a17; text-align: center; }
.h5-nav-right { right: 20px; left: auto; }
.h5-scroll { position: relative; z-index: 5; height: calc(100vh - 56px); overflow-y: auto; }
.h5-user-card { display: flex; align-items: center; gap: 18px; margin: 16px 24px; padding: 24px; background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(28,26,23,.04); }
.h5-avatar { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #C49A6C, #B8885A); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
