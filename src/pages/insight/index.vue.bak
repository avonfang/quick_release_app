<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { generateInsight, InsightResult } from '@/utils/insight'

// ─── Page state ──────────────────────────────────────────────────
type PageView = 'menu' | 'insight'
const view = ref<PageView>('menu')

// ─── User info ────────────────────────────────────────────────────
const userEmail = ref('')
const recordCount = ref(0)

onMounted(() => {
  try {
    const userInfo = uni.getStorageSync('userInfo')
    if (userInfo && userInfo.email) userEmail.value = userInfo.email
    const cards = JSON.parse(uni.getStorageSync('cards') || '[]')
    recordCount.value = cards.length
  } catch {}
})

// ─── Insight ──────────────────────────────────────────────────────
const loading = ref(false)
const insight = ref<InsightResult | null>(null)
const insightError = ref('')
const copied = ref(false)

async function loadInsight() {
  loading.value = true
  insightError.value = ''
  insight.value = null
  try {
    const result = await generateInsight()
    if (result) {
      insight.value = result
      view.value = 'insight'
    } else {
      insightError.value = '需要至少 3 条记录才能生成洞察'
    }
  } catch (e) {
    insightError.value = '生成失败，请稍后再试'
  } finally {
    loading.value = false
  }
}

function backToMenu() {
  view.value = 'menu'
}

async function copyInsight() {
  if (!insight.value) return
  const text = `「${insight.value.coreFinding}」
${insight.value.mindType} · 来自「看见此刻」`
  try {
    await uni.setClipboardData({ data: text })
    copied.value = true
    setTimeout(() => { copied.value = false }, 2000)
  } catch {}
}

function formatDate() {
  const d = new Date()
  return `${d.getFullYear()}年${d.getMonth() + 1}月`
}

// ─── Account actions ──────────────────────────────────────────────
function handleLogout() {
  uni.showModal({
    title: '退出登录',
    content: '确定要退出当前账号吗？',
    success: (res) => {
      if (res.confirm) {
        try { uni.removeStorageSync('token'); uni.removeStorageSync('userInfo') } catch {}
        uni.reLaunch({ url: '/pages/auth/index' })
      }
    },
  })
}

function handleChangePwd() {
  uni.navigateTo({ url: '/pages/auth/index?mode=forgot' })
}

function goBeliefs() {
  uni.navigateTo({ url: '/pages/beliefs/index' })
}
</script>

<template>
  <!-- ============================================================
       H5 — Profile Page
       ============================================================ -->
  <!--#ifdef H5-->
  <view class="h5-page">
    <view class="h5-grain"></view>

    <!-- ====== Menu View ====== -->
    <template v-if="view === 'menu'">
      <!-- Nav -->
      <view class="h5-nav">
        <text class="h5-nav-title">我的</text>
      </view>

      <scroll-view class="h5-scroll" scroll-y>
        <!-- User Card -->
        <view class="h5-user-card">
          <view class="h5-avatar">
            <text class="h5-avatar-text">{{ userEmail ? userEmail.charAt(0).toUpperCase() : '?' }}</text>
          </view>
          <view class="h5-user-info">
            <text class="h5-user-email">{{ userEmail || '未登录' }}</text>
            <text class="h5-user-records">{{ recordCount }} 次觉察记录</text>
          </view>
        </view>

        <!-- Menu List -->
        <view class="h5-menu">
          <!-- 心理洞察 -->
          <view class="h5-menu-item" @tap="loadInsight">
            <view class="h5-menu-icon h5-menu-icon--insight">🧠</view>
            <view class="h5-menu-body">
              <text class="h5-menu-label">心理洞察</text>
              <text class="h5-menu-desc">分析你的情绪模式</text>
            </view>
            <text class="h5-menu-arrow">›</text>
          </view>

          <!-- 我的信念 -->
          <view class="h5-menu-item" @tap="goBeliefs">
            <view class="h5-menu-icon h5-menu-icon--belief">💭</view>
            <view class="h5-menu-body">
              <text class="h5-menu-label">我的信念</text>
              <text class="h5-menu-desc">查看你的核心信念频率</text>
            </view>
            <text class="h5-menu-arrow">›</text>
          </view>

          <!-- 修改密码 -->
          <view class="h5-menu-item" @tap="handleChangePwd">
            <view class="h5-menu-icon h5-menu-icon--pwd">🔑</view>
            <view class="h5-menu-body">
              <text class="h5-menu-label">修改密码</text>
              <text class="h5-menu-desc">重置你的登录密码</text>
            </view>
            <text class="h5-menu-arrow">›</text>
          </view>

          <!-- 退出登录 -->
          <view class="h5-menu-item h5-menu-item--danger" @tap="handleLogout">
            <view class="h5-menu-icon h5-menu-icon--logout">🚪</view>
            <view class="h5-menu-body">
              <text class="h5-menu-label h5-menu-label--danger">退出登录</text>
              <text class="h5-menu-desc">退出当前账号</text>
            </view>
            <text class="h5-menu-arrow">›</text>
          </view>
        </view>
      </scroll-view>
    </template>

    <!-- ====== Insight View ====== -->
    <template v-else-if="view === 'insight'">
      <view class="h5-orb h5-orb--t"></view>
      <view class="h5-orb h5-orb--b"></view>

      <!-- Nav -->
      <view class="h5-nav">
        <view class="h5-nav-btn" @tap="backToMenu">
          <text class="h5-nav-back-icon">←</text>
          <text class="h5-nav-back-text">返回</text>
        </view>
        <text class="h5-nav-title">心理洞察</text>
        <view class="h5-nav-btn h5-nav-right" />
      </view>

      <scroll-view class="h5-scroll" scroll-y>
        <!-- Loading -->
        <view v-if="loading" class="h5-loading">
          <view class="h5-loading-ring"></view>
          <text class="h5-loading-text">分析你的记录...</text>
        </view>

        <!-- Error -->
        <view v-else-if="insightError" class="h5-empty">
          <text class="h5-empty-icon">🧘</text>
          <text class="h5-empty-title">{{ insightError }}</text>
          <text class="h5-empty-desc">继续记录，当你有足够的数据时再来看看</text>
          <view class="h5-empty-btn" @tap="backToMenu">
            <text class="h5-empty-btn-text">返回</text>
          </view>
        </view>

        <!-- Insight Card -->
        <view v-else-if="insight" class="h5-content">
          <view class="h5-card-outer">
            <view class="h5-card-inner">
              <view class="h5-card-accent"></view>
              <view class="h5-card-header">
                <view class="h5-type-badge">{{ insight.mindType }}</view>
                <text class="h5-card-subtitle">心理模式分析</text>
                <text class="h5-card-date">{{ formatDate() }}</text>
              </view>
              <view class="h5-finding">
                <view class="h5-finding-quote">"</view>
                <text class="h5-finding-text">{{ insight.coreFinding }}</text>
                <view class="h5-finding-quote h5-finding-quote--end">"</view>
              </view>
              <view class="h5-divider">
                <view class="h5-divider-line"></view>
                <text class="h5-divider-dot">✦</text>
                <view class="h5-divider-line"></view>
              </view>
              <view class="h5-patterns" v-if="insight.patterns.length">
                <text class="h5-patterns-title">模式分析</text>
                <view v-for="(p, i) in insight.patterns" :key="i" class="h5-pattern-item">
                  <view class="h5-pattern-dot"></view>
                  <view class="h5-pattern-body">
                    <text class="h5-pattern-label">{{ p.label }}</text>
                    <text class="h5-pattern-detail">{{ p.detail }}</text>
                  </view>
                </view>
              </view>
              <view class="h5-insight" v-if="insight.insight">
                <view class="h5-insight-line"></view>
                <text class="h5-insight-text">{{ insight.insight }}</text>
              </view>
              <view class="h5-card-footer">
                <text class="h5-card-footer-label">来自 看见此刻 · 情绪觉察</text>
              </view>
            </view>
          </view>
          <view class="h5-actions">
            <view class="h5-btn-primary-outer">
              <view class="h5-btn-primary-inner" @tap="copyInsight">
                <text class="h5-btn-primary-text">{{ copied ? '已复制' : '复制洞察 · 分享给朋友' }}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </template>
  </view>
  <!--#endif-->

  <!-- ============================================================
       MP-WEIXIN — Profile Page
       ============================================================ -->
  <!--#ifdef MP-WEIXIN-->
  <view class="wx-page">
    <!-- ====== Menu View ====== -->
    <view v-if="view === 'menu'">
      <view class="wx-nav">
        <text class="wx-nav-title">我的</text>
      </view>

      <scroll-view class="wx-scroll" scroll-y>
        <!-- User Card -->
        <view class="wx-user-card">
          <view class="wx-avatar">
            <text class="wx-avatar-text">{{ userEmail ? userEmail.charAt(0).toUpperCase() : '?' }}</text>
          </view>
          <view class="wx-user-info">
            <text class="wx-user-email">{{ userEmail || '未登录' }}</text>
            <text class="wx-user-records">{{ recordCount }} 次觉察记录</text>
          </view>
        </view>

        <!-- Menu -->
        <view class="wx-menu">
          <view class="wx-menu-item" @tap="loadInsight">
            <text class="wx-menu-icon">🧠</text>
            <view class="wx-menu-body">
              <text class="wx-menu-label">心理洞察</text>
              <text class="wx-menu-desc">分析你的情绪模式</text>
            </view>
            <text class="wx-menu-arrow">›</text>
          </view>
          <view class="wx-menu-item" @tap="goBeliefs">
            <text class="wx-menu-icon">💭</text>
            <view class="wx-menu-body">
              <text class="wx-menu-label">我的信念</text>
              <text class="wx-menu-desc">查看你的核心信念频率</text>
            </view>
            <text class="wx-menu-arrow">›</text>
          </view>
          <view class="wx-menu-item" @tap="handleChangePwd">
            <text class="wx-menu-icon">🔑</text>
            <view class="wx-menu-body">
              <text class="wx-menu-label">修改密码</text>
              <text class="wx-menu-desc">重置你的登录密码</text>
            </view>
            <text class="wx-menu-arrow">›</text>
          </view>
          <view class="wx-menu-item wx-menu-item--danger" @tap="handleLogout">
            <text class="wx-menu-icon">🚪</text>
            <view class="wx-menu-body">
              <text class="wx-menu-label wx-menu-label--danger">退出登录</text>
              <text class="wx-menu-desc">退出当前账号</text>
            </view>
            <text class="wx-menu-arrow">›</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ====== Insight View ====== -->
    <view v-else-if="view === 'insight'">
      <view class="wx-nav">
        <view class="wx-nav-back" @tap="backToMenu">
          <text class="wx-nav-back-icon">←</text>
        </view>
        <text class="wx-nav-title">心理洞察</text>
      </view>
      <view v-if="loading" class="wx-loading"><text class="wx-loading-text">分析中...</text></view>
      <view v-else-if="insightError" class="wx-empty"><text>{{ insightError }}</text></view>
      <view v-else-if="insight" class="wx-insight">
        <view class="wx-type">{{ insight.mindType }}</view>
        <text class="wx-finding">{{ insight.coreFinding }}</text>
      </view>
    </view>
  </view>
  <!--#endif-->
</template>

<!--#ifdef H5-->
<style>
