{
  "buildCommand": "npm run build:h5",
  "outputDirectory": "dist/build/h5",
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "https://api.deepseek.com/v1/$1" },
    { "source": "/api/(.*)", "destination": "https://sumeru.online/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
